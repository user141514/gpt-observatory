{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./server",
    "outDir": "./.release/server",
    "declaration": false,
    "sourceMap": false,
    "noEmit": false,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": [
    "server/bootstrap.ts",
    "server/index.ts",
    "server/agent-cli.ts",
    "server/agent-mcp.ts"
  ]
}
